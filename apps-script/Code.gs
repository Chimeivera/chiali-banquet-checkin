/** 在新建的 Google 試算表 → 擴充功能 → Apps Script 使用。 */
function setup(){
 const props=PropertiesService.getScriptProperties();const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('請從 Google 試算表開啟 Apps Script');props.setProperty('SPREADSHEET_ID',ss.getId());if(!props.getProperty('ACCESS_KEY'))props.setProperty('ACCESS_KEY',Utilities.getUuid()+Utilities.getUuid());if(!props.getProperty('ALLOWED_ORIGIN'))props.setProperty('ALLOWED_ORIGIN','https://chimeivera.github.io');
 let sheet=ss.getSheetByName('賓客資料');if(!sheet){sheet=ss.insertSheet('賓客資料');const cols=['id','name','category','department','title','expected','staff','award','awardGroup','awardDeclined','meal','shortcode','phone','note','checked','seat','escorted','explained','notified','contact_status','operator','updated','现场'];sheet.appendRow(cols);sheet.getRange(2,1,INITIAL_ROSTER.length,cols.length).setNumberFormat('@').setValues(INITIAL_ROSTER.map(p=>cols.map(k=>p[k]===undefined?'':String(p[k]))));sheet.setFrozenRows(1)}
 if(!ss.getSheetByName('操作紀錄'))ss.insertSheet('操作紀錄').appendRow(['時間','操作','人員ID','內容']);
}
function doGet(){return HtmlService.createHtmlOutput('餐敘後端已部署。請從 GitHub 簽到網頁使用。')}
function doPost(e){let q={},status=200,data;try{q=JSON.parse(e.parameter.payload||'{}');const props=PropertiesService.getScriptProperties();if(q.origin!==props.getProperty('ALLOWED_ORIGIN')||!q.key||q.key!==props.getProperty('ACCESS_KEY'))throw Error('存取碼或網站來源不正確');data=dispatch(q)}catch(err){status=err.status||400;data={error:err.message,code:err.code||''}}const reply=JSON.stringify({requestId:q.requestId,status,data}).replace(/</g,'\\u003c');const origin=JSON.stringify(PropertiesService.getScriptProperties().getProperty('ALLOWED_ORIGIN')||'https://chimeivera.github.io');return HtmlService.createHtmlOutput('<script>window.top.postMessage('+reply+','+origin+');</script>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function dispatch(q){if(q.method==='GET'&&q.path==='/api/people'){const ss=SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID'));return readRoster(ss.getSheetByName('賓客資料'))}const lock=LockService.getScriptLock();if(!lock.tryLock(25000))throw Error('目前多人操作，請稍後重試');try{return operate(q)}finally{lock.releaseLock()}}
function fail(message,code){const err=Error(message);err.status=409;err.code=code;throw err}
function readRoster(sheet){const values=sheet.getDataRange().getValues(),cols=values.shift();return values.filter(r=>r[0]).map(r=>{const p={};cols.forEach((k,i)=>p[k]=String(r[i]??''));['expected','staff','awardDeclined'].forEach(k=>p[k]=p[k]==='true');['checked','escorted','explained','notified'].forEach(k=>p[k]=Number(p[k]||0));return p})}
function writePerson(sheet,p,row){const cols=sheet.getRange(1,1,1,sheet.getLastColumn()).getValues()[0];sheet.getRange(row,1,1,cols.length).setNumberFormat('@').setValues([cols.map(k=>p[k]===undefined?'':String(p[k]))])}
function operate(q){const ss=SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID')),sheet=ss.getSheetByName('賓客資料'),roster=readRoster(sheet),b=q.body||{};const remaining=164-roster.filter(p=>p.expected).length-roster.filter(p=>!p.expected&&p.checked).length;const now=Utilities.formatDate(new Date(),'Asia/Taipei','yyyy/MM/dd HH:mm:ss');const log=(op,id,info)=>ss.getSheetByName('操作紀錄').appendRow([now,op,id,info]);
 if(q.method==='GET'&&q.path==='/api/people')return roster;
 if(q.method==='POST'&&q.path==='/api/reset'){if(b.confirmation!=='重設測試紀錄')throw Error('缺少重設確認');const stamp=Utilities.formatDate(new Date(),'Asia/Taipei','yyyyMMdd_HHmmss')+'_'+Utilities.getUuid().slice(0,5);sheet.copyTo(ss).setName('備份_'+stamp);roster.forEach(p=>{const original=INITIAL_ROSTER.find(x=>x.id===p.id);Object.assign(p,{checked:0,seat:'',note:original?.note||'',现场:'',escorted:0,explained:0,notified:0,contact_status:'',operator:'',updated:'',meal:original?.meal||p.meal})});const cols=sheet.getRange(1,1,1,sheet.getLastColumn()).getValues()[0];if(roster.length)sheet.getRange(2,1,roster.length,cols.length).setNumberFormat('@').setValues(roster.map(p=>cols.map(k=>String(p[k]??''))));log('重設','','備份_'+stamp);SpreadsheetApp.flush();return {ok:true,backupId:stamp}}
 if(q.method==='POST'&&q.path==='/api/walkins'){const name=String(b.name||'').trim(),id=String(b.id||'').trim().toUpperCase();if(!name||name.length>80||!['葷','素食','蛋奶素'].includes(b.meal))throw Error('請確認姓名及餐別');if(roster.some(p=>p.name===name||(id&&p.id===id)))fail('名單已有此人，請搜尋後簽到','duplicate');if(remaining<=0&&!b.capacityConfirmed)fail('容量已用盡，請先確認座位','capacity');const p={id:id||'walkin-'+Utilities.getUuid(),name,category:String(b.category||'其他').slice(0,40),department:String(b.department||'').slice(0,100),title:'',expected:false,staff:false,meal:b.meal,checked:1,operator:'未指定工作人員',updated:now};writePerson(sheet,p,sheet.getLastRow()+1);log('臨時新增',p.id,p.meal);SpreadsheetApp.flush();return p}
 if(q.method==='PATCH'&&q.path.startsWith('/api/people/')){const id=decodeURIComponent(q.path.slice('/api/people/'.length)),index=roster.findIndex(p=>p.id===id);if(index<0)throw Error('查無此人');const p=roster[index];if(b.checked===1&&p.checked)return {ok:true,alreadyChecked:true};if(b.checked===1&&!p.expected&&remaining<=0&&!b.capacityConfirmed)fail('容量已用盡','capacity');const allowed=['checked','seat','note','meal','escorted','explained','notified','contact_status'];for(const k of allowed){if(!(k in b))continue;if(['checked','escorted','explained','notified'].includes(k)&&![0,1].includes(b[k]))throw Error('無效狀態');if(['seat','note'].includes(k)&&(typeof b[k]!=='string'||b[k].length>2000))throw Error('文字過長');if(k==='meal'&&!['葷','素食','蛋奶素'].includes(b[k]))throw Error('無效餐別');if(k==='contact_status'&&!['尚未聯繫','聯繫中','未接','稍後抵達','臨時不克'].includes(b[k]))throw Error('無效聯繫狀態');if(k==='note')p.现场=b[k];else p[k]=b[k]}
 p.operator='未指定工作人員';p.updated=now;writePerson(sheet,p,index+2);log('更新',id,JSON.stringify(b));SpreadsheetApp.flush();return {ok:true,alreadyChecked:false}}
 throw Error('不支援的操作')}
